{
  "manifest_version": 3,
  "name": "Social Media Crawler",
  "version": "0.1.0",
  "description": "One-click download button on every image and video on Instagram, YouTube, TikTok, Facebook, X, Pinterest and Threads.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*",
        "https://*.facebook.com/*", "https://x.com/*", "https://twitter.com/*",
        "https://*.pinterest.com/*", "https://*.threads.com/*", "https://*.threads.net/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
